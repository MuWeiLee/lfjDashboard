# Do not put real credentials in this file.
# Copy it to .env or configure these values in the operating system.

# Optional: custom location of the installed Wind MCP skill.
WIND_SKILL_DIR=C:\\path\\to\\wind-mcp-skill

# If your own data adapter requires a key, keep the real value local only.
WIND_API_KEY=YOUR_API_KEY_HERE

TA_HOST=127.0.0.1
TA_PORT=8799
